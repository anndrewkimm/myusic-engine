{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myusic-engine.local/schemas/user-track-affinity-v1.json",
  "title": "User-track behavioral affinity",
  "type": "object",
  "required": [
    "schema_version",
    "track_id",
    "track_identity_source",
    "first_played_at",
    "last_played_at",
    "aggregation_as_of",
    "play_count",
    "total_ms_played",
    "median_ms_played",
    "duration_coverage_rate",
    "completion_signal_coverage",
    "early_skip_signal_coverage",
    "intentional_start_signal_coverage",
    "repeat_within_session_rate",
    "recency_weighted_plays",
    "recency_score",
    "affinity_score",
    "affinity_confidence",
    "affinity_components",
    "scoring_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "track_id": { "type": "string", "minLength": 1 },
    "track_identity_source": { "enum": ["spotify_uri", "metadata_hash"] },
    "track_uri": { "type": ["string", "null"] },
    "track_name": { "type": ["string", "null"] },
    "artist_name": { "type": ["string", "null"] },
    "album_name": { "type": ["string", "null"] },
    "first_played_at": { "type": "string", "format": "date-time" },
    "last_played_at": { "type": "string", "format": "date-time" },
    "aggregation_as_of": { "type": "string", "format": "date-time" },
    "play_count": { "type": "integer", "minimum": 1 },
    "total_ms_played": { "type": "integer", "minimum": 0 },
    "median_ms_played": { "type": "number", "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 1 },
    "duration_coverage_rate": { "$ref": "#/$defs/rate" },
    "median_completion_ratio": { "$ref": "#/$defs/nullableRate" },
    "completion_rate": { "$ref": "#/$defs/nullableRate" },
    "completion_signal_coverage": { "$ref": "#/$defs/rate" },
    "early_skip_rate": { "$ref": "#/$defs/nullableRate" },
    "early_skip_signal_coverage": { "$ref": "#/$defs/rate" },
    "intentional_start_rate": { "$ref": "#/$defs/nullableRate" },
    "intentional_start_signal_coverage": { "$ref": "#/$defs/rate" },
    "repeat_within_session_rate": { "$ref": "#/$defs/rate" },
    "recency_weighted_plays": { "type": "number", "minimum": 0 },
    "recency_score": { "$ref": "#/$defs/rate" },
    "affinity_score": { "type": "number" },
    "affinity_confidence": { "$ref": "#/$defs/rate" },
    "affinity_components": {
      "type": "object",
      "required": ["play_count", "completion", "intentional_start", "recency", "early_skip"],
      "properties": {
        "play_count": { "type": "number" },
        "completion": { "type": "number" },
        "intentional_start": { "type": "number" },
        "recency": { "type": "number" },
        "early_skip": { "type": "number" }
      },
      "additionalProperties": false
    },
    "scoring_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "nullableRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
