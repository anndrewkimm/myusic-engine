{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myusic-engine.local/schemas/spotify-playlist-plan-v1.json",
  "title": "Private Spotify playlist publication plan",
  "type": "object",
  "required": [
    "schema_version", "plan_id", "playlist_name", "description", "public", "item_count",
    "spotify_uris"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "playlist_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "public": { "const": false },
    "item_count": { "type": "integer", "minimum": 1 },
    "spotify_uris": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^spotify:track:[A-Za-z0-9]{22}$"
      }
    }
  },
  "additionalProperties": false
}
