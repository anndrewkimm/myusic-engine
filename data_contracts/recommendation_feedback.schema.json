{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myusic-engine.local/schemas/recommendation-feedback-v1.json",
  "title": "Explicit recommendation feedback",
  "type": "object",
  "required": [
    "schema_version", "feedback_id", "recommendation_run_id", "track_id", "outcome",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "feedback_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recommendation_run_id": { "type": "string", "minLength": 1 },
    "track_id": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["accepted", "rejected", "saved", "skipped", "listened"] },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
