{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myusic-engine.local/schemas/taste-model-v1.json",
  "title": "Portable standardized logistic taste model",
  "type": "object",
  "required": [
    "schema_version", "model_id", "model_name", "model_version", "dataset_version",
    "feature_names", "preprocessing", "linear_model", "feature_groups", "profile_name",
    "profile_version", "training_rows", "training_positive_rate", "training_period_end"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "model_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_name": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "feature_names": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "preprocessing": {
      "type": "object",
      "required": ["kind", "means", "scales"],
      "properties": {
        "kind": { "const": "training_only_standard_scaler" },
        "means": { "$ref": "#/$defs/vector" },
        "scales": { "$ref": "#/$defs/vector" }
      },
      "additionalProperties": false
    },
    "linear_model": {
      "type": "object",
      "required": ["kind", "coefficients", "intercept"],
      "properties": {
        "kind": { "const": "binary_logistic_regression_l2" },
        "coefficients": { "$ref": "#/$defs/vector" },
        "intercept": { "type": "number" }
      },
      "additionalProperties": false
    },
    "feature_groups": {
      "type": "object",
      "required": ["behavior", "descriptors", "embedding"],
      "properties": {
        "behavior": { "type": "boolean" },
        "descriptors": { "type": "boolean" },
        "embedding": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "profile_name": { "type": ["string", "null"] },
    "profile_version": { "type": ["string", "null"] },
    "training_rows": { "type": "integer", "minimum": 1 },
    "training_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "training_period_end": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "vector": { "type": "array", "minItems": 1, "items": { "type": "number" } }
  },
  "additionalProperties": false
}
