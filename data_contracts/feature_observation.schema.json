{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myusic-engine.local/schemas/feature-observation-v1.json",
  "title": "Source-tagged feature observation",
  "type": "object",
  "required": [
    "schema_version",
    "track_id",
    "feature_name",
    "feature_source",
    "source_version",
    "coverage_seconds",
    "feature_confidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "track_id": { "type": "string", "minLength": 1 },
    "feature_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$" },
    "value_number": { "type": "number" },
    "value_text": { "type": "string" },
    "value_vector": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    },
    "feature_source": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string", "minLength": 1 },
    "coverage_seconds": { "type": "number", "minimum": 0 },
    "feature_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "oneOf": [
    { "required": ["value_number"] },
    { "required": ["value_text"] },
    { "required": ["value_vector"] }
  ],
  "additionalProperties": false
}
