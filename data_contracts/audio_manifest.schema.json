{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myusic-engine.local/schemas/audio-manifest-item-v1.json",
  "title": "Private permitted-audio manifest item",
  "type": "object",
  "required": ["track_id", "audio_path", "rights_basis"],
  "properties": {
    "track_id": { "type": "string", "minLength": 1 },
    "audio_path": { "type": "string", "minLength": 1 },
    "rights_basis": {
      "enum": ["owned", "licensed", "public_domain", "creative_commons"]
    }
  },
  "additionalProperties": false
}
